# Maintainer: ApiPlant <releases@apiplant.com>
pkgname=rembg-rs-cuda
pkgver=@VERSION@
pkgrel=1
pkgdesc="Native Rust background removal with Bria RMBG-3.0 (CUDA build)"
arch=('x86_64')
url="https://rembg-rs.apiplant.com"
license=('MIT')
depends=('glibc' 'nvidia-utils' 'cuda')
provides=('rembg-rs')
conflicts=('rembg-rs')
# @ARCHIVE_PREFIX@ is the Arch-built CUDA archive when that job succeeded, or
# the generic CUDA archive when rolling Arch broke it. The workflow fills this
# in together with the version and checksum.
source=("rembg-rs-cuda-$pkgver-x86_64.tar.gz::https://github.com/apiplant/rembg-rs/releases/download/v$pkgver/@ARCHIVE_PREFIX@-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA_LINUX_X86_64_CUDA@')
options=('!strip' '!debug')

package() {
  install -Dm755 "$srcdir/rembg-rs" "$pkgdir/usr/bin/rembg-rs"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/rembg-rs-cuda/README.md"
}
